[Unit]
Description=AlpacApps Paint Color Analyzer Worker
After=network.target

[Service]
Type=simple
User=bugfixer
Environment=HOME=/home/bugfixer
WorkingDirectory=/opt/paint-analyzer
EnvironmentFile=/opt/paint-analyzer/.env
ExecStart=/usr/bin/node /opt/paint-analyzer/worker.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paint-analyzer

[Install]
WantedBy=multi-user.target
