# oci-a1-provisioner config. Lives at ~/.config/oci-a1-provisioner/config.env (chmod 600).
# Docs: scripts/oci-a1-provisioner/README.md
# Validate after editing:  ~/.venvs/oci-a1-provisioner/bin/python ~/scripts/oci-a1-provisioner/provision.py check

# --- OCI API auth (created by `oci setup config`; see README "One-time OCI setup") ---
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# --- Target ---
REGION=ca-montreal-1           # MUST be the tenancy's home region for Always Free A1
COMPARTMENT_ID=                # tenancy (root) OCID, or a child compartment OCID
SUBNET_ID=                     # a PUBLIC subnet in REGION (the subnet OCID embeds the region code, e.g. .yul.)
SSH_PUBLIC_KEY_FILE=~/.ssh/oracle_key.pub
DISPLAY_NAME=alpacapps-workers # also the idempotency key: an instance with this name = done

# --- Shape (Always Free ceiling: 4 OCPU / 24 GB A1 total, 200 GB block storage total) ---
OCPUS=4
MEMORY_GB=24
BOOT_VOLUME_GB=200
IMAGE_ID=                      # blank = newest Canonical Ubuntu $UBUNTU_VERSION aarch64, resolved per region
UBUNTU_VERSION=24.04

# --- Guardrails ---
REQUIRE_HOME_REGION=true       # refuse to launch outside the home region (would not be free)
MAX_DAYS=90                    # stop + notify after this many days without success (0 = never)
HEARTBEAT_DAYS=7               # "still trying" notification interval

# --- Notifications (macOS notification always; email if both set) ---
RESEND_API_KEY=                # bw-read "Resend" "api_key" — see docs/CREDENTIALS.md
NOTIFY_EMAIL=
NOTIFY_FROM=noreply@alpacaplayhouse.com
