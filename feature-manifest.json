      "stripe-payout",
      "record-payment",
      "resolve-payment",
      "confirm-deposit-payment",
      "create-payment-link"
    ],
    "pages": ["pay/"],
    "dbTables": ["stripe_payments", "stripe_config", "ledger", "payouts", "payment_methods"]
  },

  "payments_square": {
    "label": "Square Payments",
