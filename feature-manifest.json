{
  "_meta": {
    "description": "Maps features to their files, directories, edge functions, and DB tables. Used by the setup wizard to prune content based on the selected profile.",
    "profiles": {
      "property_management": "All features — full property management stack with smart home, renters, events, etc.",
      "general_ai_enablement": "Core framework only — auth, payments, email, permissions, accounting. No property-specific overhead."
    }
  },

  "core": {
    "_note": "Always included regardless of profile. Cannot be disabled.",
    "dirs": [
      "shared/supabase.js",
      "shared/auth.js",
      "shared/admin-shell.js",
      "shared/public-shell.js",
      "shared/brand-config.js",
      "shared/config-loader.js",
      "shared/feature-registry.js",
      "shared/error-logger.js",
      "shared/supabase-health.js",
      "shared/site-components.js",
      "shared/tab-utils.js",
      "shared/timezone.js",
      "shared/version-info.js",
      "shared/media-service.js",
      "shared/pdf-service.js",
      "shared/identity-service.js",
      "shared/project-service.js",
      "login/",
      "contact/",
      "styles/",
      "assets/"
    ],
    "edgeFunctions": [
      "api",
      "contact-form",
      "error-report",
      "verify-identity",
      "_shared"
    ],
    "dbTables": [
      "app_users",
      "user_invitations",
      "property_config",
      "brand_config",
      "identity_verifications",
      "spaces",
      "people",
      "assignments",
      "assignment_spaces",
      "media",
      "media_spaces",
      "media_tags",
      "media_tag_assignments",
      "upload_tokens"
    ]
  },

  "email": {
    "label": "Email (Resend)",
    "shared": [
      "shared/email-service.js",
      "shared/email-template-service.js"
    ],
    "edgeFunctions": [
      "send-email",
      "edit-email-template",
      "resend-inbound-webhook"
    ],
    "dbTables": ["email_templates", "inbound_emails"]
  },

  "sms": {
    "label": "SMS (Telnyx)",
    "shared": ["shared/sms-service.js"],
    "edgeFunctions": ["send-sms", "telnyx-webhook"],
    "dbTables": ["sms_messages", "telnyx_config"]
  },

  "whatsapp": {
    "label": "WhatsApp",
    "shared": ["shared/whatsapp-service.js"],
    "edgeFunctions": ["send-whatsapp", "whatsapp-webhook"],
    "dbTables": []
